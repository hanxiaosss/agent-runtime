{
  "name": "agent-runtime-trace",
  "displayName": "Agent Runtime Governance",
  "description": "Agent governance panel: real-time trace, policy management, and status monitoring",
  "version": "0.2.0",
  "publisher": "agent-runtime",
  "engines": {
    "vscode": "^1.79.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:.harness"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "agentRuntime",
          "title": "Agent Runtime",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "agentRuntime": [
        {
          "id": "agentRuntime.traceView",
          "name": "Tool Call Chain",
          "icon": "$(list-tree)",
          "contextualTitle": "Agent Runtime Trace"
        },
        {
          "id": "agentRuntime.policyView",
          "name": "Policies & Rules",
          "icon": "$(shield)",
          "contextualTitle": "Agent Runtime Policies"
        }
      ]
    },
    "commands": [
      {
        "command": "agentRuntime.refresh",
        "title": "Refresh",
        "category": "Agent Runtime",
        "icon": "$(refresh)"
      },
      {
        "command": "agentRuntime.clear",
        "title": "Clear Trace",
        "category": "Agent Runtime",
        "icon": "$(clear-all)"
      },
      {
        "command": "agentRuntime.filterDenied",
        "title": "Show Denied Only",
        "category": "Agent Runtime",
        "icon": "$(filter)"
      },
      {
        "command": "agentRuntime.showTraceView",
        "title": "Show Trace View",
        "category": "Agent Runtime"
      },
      {
        "command": "agentRuntime.showPolicyView",
        "title": "Show Policy View",
        "category": "Agent Runtime"
      },
      {
        "command": "agentRuntime.timeWindow5m",
        "title": "Show Last 5 Minutes",
        "category": "Agent Runtime"
      },
      {
        "command": "agentRuntime.timeWindow1h",
        "title": "Show Last 1 Hour",
        "category": "Agent Runtime"
      },
      {
        "command": "agentRuntime.timeWindowToday",
        "title": "Show All Today",
        "category": "Agent Runtime"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentRuntime.refresh",
          "when": "view == agentRuntime.traceView || view == agentRuntime.policyView",
          "group": "navigation"
        },
        {
          "command": "agentRuntime.filterDenied",
          "when": "view == agentRuntime.traceView",
          "group": "navigation"
        },
        {
          "command": "agentRuntime.clear",
          "when": "view == agentRuntime.traceView"
        }
      ],
      "view/item/context": [
        {
          "command": "agentRuntime.toggleRuleEnabled",
          "when": "view == agentRuntime.policyView && viewItem == rule",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Agent Runtime",
      "properties": {
        "agentRuntime.traceDir": {
          "type": "string",
          "default": ".harness/traces",
          "description": "Path to trace directory (relative to workspace root)"
        },
        "agentRuntime.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh trace view when files change"
        },
        "agentRuntime.maxEntries": {
          "type": "number",
          "default": 1000,
          "description": "Maximum number of trace entries to keep in memory"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/vscode": "^1.79.0",
    "typescript": "^5.6.0"
  }
}